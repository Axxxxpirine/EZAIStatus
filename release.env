# Mises à jour Sparkle, gravées dans l'app au build. Vides : l'updater reste inactif.
# SPARKLE_FEED_URL : adresse HTTPS publique de appcast.xml (site encore à choisir).
# SPARKLE_PUBLIC_KEY : clé publique EdDSA (generate_keys de Sparkle ; la clé privée reste dans le trousseau).
# Les variables d'environnement du même nom ont priorité (utile pour un essai local).
SPARKLE_FEED_URL=
SPARKLE_PUBLIC_KEY=
